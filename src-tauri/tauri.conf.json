{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scholar Citation Tracker",
  "version": "1.1.1",
  "identifier": "io.github.bcankara.scholarcitationtracker",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Scholar Citation Tracker",
        "width": 1150,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "Scholar Citation Tracker",
    "shortDescription": "Google Scholar citation tracker",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Turkish"],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3RjUwOTI3QjYyQTM0NjMKUldSak5DcTJKd24xUjBLeEdycDhmQkt0dFpHdi9yNkJ0aFhTSU1jZG5PbGFWNkk4cUw4a0MxeWYK",
      "endpoints": ["https://github.com/bcankara/scholar-citation-tracker/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
